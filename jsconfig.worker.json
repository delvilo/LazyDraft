{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2022", "WebWorker", "WebWorker.Iterable"]
  },
  "include": [
    "ai-regexr/js/contracts.js",
    "ai-regexr/js/regex-worker.js",
    "ai-regexr/js/engines/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "ai-regexr/vendor/**",
    "ai-regexr/sw.js"
  ]
}
