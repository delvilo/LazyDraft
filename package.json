{
  "name": "lazydraft",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.*",
    "typecheck:dom": "tsc -p jsconfig.json",
    "typecheck:worker": "tsc -p jsconfig.worker.json",
    "typecheck": "npm run typecheck:dom && npm run typecheck:worker",
    "test:ime:browser": "playwright test -c playwright.ime.config.mjs",
    "release": "node scripts/release-regexr.mjs",
    "vendor": "node scripts/vendor-regexr.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  }
}
